# Переменные окружения решения «Профиль 10».
# Скопируйте в .env и заполните. Рабочие токены в репозиторий не коммитятся.

# --- обязательные ---
# Токен чат-бота MAX (выдаёт организатор/владелец бота в MAX).
MAX_BOT_TOKEN=
# Секрет подписи токенов мини-приложения. Любая случайная строка от 32 символов:
#   openssl rand -hex 32
APP_SECRET=
# Общий ключ служебного контура бот -> API. Тоже случайная строка.
INTERNAL_KEY=

# --- адреса ---
# Публичный HTTPS-адрес, по которому MAX открывает мини-приложение.
# Мини-приложение в MAX работает только по HTTPS.
PUBLIC_BASE_URL=https://example.org
# Базовый адрес Bot API MAX. Менять нужно только для стенда.
MAX_API_BASE=https://botapi.max.ru
# Тип кнопки запуска мини-приложения: link — обычная ссылка (работает всегда).
# Если в текущей версии платформы есть отдельный тип кнопки запуска
# мини-приложения, укажите его имя здесь.
MINIAPP_BUTTON_TYPE=link

# --- порты ---
API_PORT=8080
STAND_PORT=8081

# --- настройки продукта ---
# Порог k-анонимности: со скольких анкет школе показывается агрегат по классу.
MIN_AGGREGATE=5
# Сколько направлений разрешено отметить ученику.
MAX_FIELDS=8
# За сколько дней до срока подачи заявления присылать напоминание.
REMINDER_DAYS_BEFORE=3
# Демо-режим напоминания: прислать через N секунд вместо срока. 0 — выключено.
REMINDER_DEMO_DELAY=0

# --- прочее ---
CORS_ORIGINS=*
POLL_TIMEOUT=30
LOG_LEVEL=INFO
