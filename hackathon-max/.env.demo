# Значения для локальной проверки сценария на стенде-эмуляторе MAX.
# Это НЕ рабочие секреты: стенд принимает строку demo-token и никуда не ходит.
# Для работы с настоящей платформой используйте .env.example и реальный токен.
MAX_BOT_TOKEN=demo-token
MAX_API_BASE=http://maxstand:8081
APP_SECRET=demo-only-not-a-secret-0000000000
INTERNAL_KEY=demo-only-not-a-secret-1111111111
PUBLIC_BASE_URL=http://localhost:8080
MINIAPP_BUTTON_TYPE=link
API_PORT=8080
STAND_PORT=8081
MIN_AGGREGATE=5
MAX_FIELDS=8
REMINDER_DAYS_BEFORE=3
REMINDER_DEMO_DELAY=20
CORS_ORIGINS=*
POLL_TIMEOUT=5
LOG_LEVEL=INFO
